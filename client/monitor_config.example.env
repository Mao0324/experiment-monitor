# Use the HTTPS domain configured on the Ubuntu monitoring server.
YOLO_MONITOR_URL=https://monitor.example.com

# Must exactly match MONITOR_API_TOKEN on the server.
YOLO_MONITOR_TOKEN=replace-with-server-api-token

# false (default) ignores HTTP_PROXY/HTTPS_PROXY for monitoring requests.
YOLO_MONITOR_USE_PROXY=false

# Optional. The Python constructor argument takes precedence.
YOLO_EXPERIMENT_NAME=my-yolo-experiment

# YOLO_MONITOR_RUN_ID and YOLO_MONITOR_STARTED_AT are generated by monitor.run().
# Do not set them manually; Ultralytics DDP children inherit them automatically.
