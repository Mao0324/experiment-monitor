# Service
MONITOR_BIND=127.0.0.1
MONITOR_PORT=8765
MONITOR_DB=/opt/experiment-monitor/data/monitor.db
MONITOR_DOWNLOAD_DIR=/opt/experiment-monitor/downloads
MONITOR_PUBLIC_URL=https://monitor.example.com
MONITOR_COOKIE_SECURE=true
# A running experiment with no progress report for this many seconds is marked stalled.
MONITOR_STALE_SECONDS=600
MONITOR_WATCHDOG_SECONDS=60

# Daily SQLite backup. Experiment auto-deletion is disabled unless explicitly set > 0.
MONITOR_BACKUP_DIR=/opt/experiment-monitor/data/backups
MONITOR_BACKUP_KEEP_DAYS=14
MONITOR_BACKUP_KEEP_COUNT=14
MONITOR_RUN_RETENTION_DAYS=0

# Generate each value independently with: openssl rand -hex 32
MONITOR_API_TOKEN=replace-with-a-random-64-character-token
MONITOR_SESSION_SECRET=replace-with-another-random-64-character-secret

# Password required for delete, favorite, group and tag mutations. Read-only pages are public.
MONITOR_ADMIN_PASSWORD=replace-with-dashboard-password

# QQ Mail SMTP. Use an SMTP authorization code, never the QQ login password.
QQ_SMTP_HOST=smtp.qq.com
QQ_SMTP_PORT=465
QQ_SMTP_USER=your-account@qq.com
QQ_SMTP_AUTH_CODE=replace-with-qq-smtp-authorization-code
MONITOR_MAIL_TO=recipient@qq.com
