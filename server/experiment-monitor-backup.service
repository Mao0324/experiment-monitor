[Unit]
Description=YOLO Experiment Monitor SQLite backup
After=experiment-monitor.service

[Service]
Type=oneshot
User=experiment-monitor
Group=experiment-monitor
EnvironmentFile=/etc/experiment-monitor.env
ExecStart=/usr/bin/python3 /opt/experiment-monitor/app/monitor_maintenance.py
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/experiment-monitor/data
