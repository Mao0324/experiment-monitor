* text=auto

# Linux deployment and Python sources must remain executable/readable on Ubuntu.
*.sh text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.template text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.env.example text eol=lf

# Native Windows client sources.
*.cs text eol=crlf
*.ps1 text eol=crlf
*.manifest text eol=crlf
*.ico binary
